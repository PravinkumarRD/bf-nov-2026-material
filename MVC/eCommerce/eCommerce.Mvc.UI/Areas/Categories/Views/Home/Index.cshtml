@model IEnumerable<Category>

@{
    ViewData["Title"] = "Categories List!";
}

@if (Model != null && Model.Count() > 0)
{
    <h1>@ViewData["PageTitle"]</h1>
    <hr />
    <table class="table table-hover table-striped">
        <thead>
            <tr>
                <th>Category Name</th>
                <th>Category Description</th>
                <th>Show Products</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.CategoryName</td>
                    <td>@category.Description</td>
                    <td>
                        <a class="btn btn-primary" asp-area="Products" asp-controller="Home" asp-action="CatWiseProducts" asp-route-id="@category.CategoryId">Show Products</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h2>We Didn't Find Any Categories!</h2>
}