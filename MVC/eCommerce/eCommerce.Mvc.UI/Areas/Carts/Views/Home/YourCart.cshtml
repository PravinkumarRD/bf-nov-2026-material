@model IEnumerable<YourCartVm>
@{
    ViewData["Title"] = "Your Cart!";
}
@if (Model != null && Model.Count() > 0)
{


    <table class="table table-hover table-striped">
        <thead>
            <tr>
                <th>Category Name</th>
                <th>Product Name</th>
                <th>Unit Price</th>
                <th>Discount</th>
                <th>Quantity</th>
                <th>Size</th>
                <th>Total Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cartItem in Model)
            {
                <tr>
                    <td>@cartItem.CategoryName</td>
                    <td>@cartItem.ProductName</td>
                    <td>@cartItem.Price</td>
                    <td>@cartItem.Discount</td>
                    <td>@cartItem.Quantity</td>
                    <td>@cartItem.Size</td>
                    <td>@cartItem.TotalPrice</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h2>Your Cart is Empty! Please add the products!</h2>
}