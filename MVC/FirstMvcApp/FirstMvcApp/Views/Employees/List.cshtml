@model List<Employee>
@{
    // ViewData["Title"] = "Bajaj Employees List!";
    ViewBag.Title = "Hello Employees";
}
<h1>@ViewBag.PageTitle</h1>
<hr />
<h6>@ViewBag.PageSubTitle</h6>

<table class="table table-hover table-striped">
    <thead>
        <tr>
            <th>Employee Id</th>
            <th>Employee Name</th>
            <th>Employee City</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.EmployeeId</td>
                <td>@employee.EmployeeName</td>
                <td>@employee.City</td>
            </tr>
        }
    </tbody>
</table>